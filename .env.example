# Database Connection (SQLite by default for zero-config local run)
DATABASE_URL="file:./dev.db"

# JWT Secret for Secure Authentication Sessions
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars-long"

# Google Gemini API Key for AI Task Breakdown & Sprint Intelligence
# (Leave blank or set to 'demo' to run in Built-in Heuristic AI Fallback Mode)
GEMINI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
